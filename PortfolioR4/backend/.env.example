# Plantilla del backend; config/env.js carga backend/.env. No publicar valores privados.
# Puerto para ejecutar Express localmente; Vercel no usa app.listen.
PORT=3001
# URL de Supabase usada por login, sesiones, CRUD, Storage y contacto; también se usa en CSP.
SUPABASE_URL=
# Clave privada del backend. Nunca usar una variable VITE_ aquí.
SUPABASE_SECRET_KEY=
# Origen permitido para escrituras (esquema, host y puerto), además del origen del servidor.
FRONTEND_URL=
# 1 confía en un proxy inverso; 0 mantiene el comportamiento directo de Express.
TRUST_PROXY=0
